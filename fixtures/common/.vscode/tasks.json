{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "Demo: Vorbereiten (bestehende Daten behalten)",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "prepare"],
      "problemMatcher": []
    },
    {
      "label": "Demo: Ausgangsdatei zurücksetzen (überschreiben)",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "reset-baseline", "${input:confirmFileReset}"],
      "problemMatcher": []
    },
    {
      "label": "Demo: BMad-Skills installieren",
      "type": "shell", "command": "npx",
      "args": ["skills", "add", "bmad-code-org/BMAD-METHOD", "--skill", "bmad", "--skill", "bmod-core-tools", "--skill", "bmod-method", "--skill", "bmad-agent-po", "--skill", "bmad-build", "--agent", "github-copilot", "--copy"],
      "options": { "cwd": "${workspaceFolder}\\..\\baseline" },
      "problemMatcher": []
    },
    {
      "label": "Demo: BMad Initial-Commit (lokal)",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "init-bmad-commit", "${input:confirmCommit}"],
      "problemMatcher": []
    },
    {
      "label": "Demo: Ticket vorbereiten",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "prepare-bmad-ticket"],
      "problemMatcher": []
    },
    {
      "label": "Demo: Bauen",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "build", "${workspaceFolderBasename}"],
      "group": "build", "problemMatcher": []
    },
    {
      "label": "Demo: Starten",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "run", "${workspaceFolderBasename}"],
      "problemMatcher": [], "presentation": { "reveal": "always" }
    },
    {
      "label": "Demo: Ausgangsversion testen",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "test", "baseline"],
      "problemMatcher": [], "presentation": { "reveal": "always" }
    },
    {
      "label": "Demo: Referenzlösung testen",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "test", "solution"],
      "problemMatcher": [], "presentation": { "reveal": "always" }
    },
    {
      "label": "Demo: Diff anzeigen",
      "type": "process", "command": "node", "args": ["..\\..\\demo.mjs", "diff"],
      "problemMatcher": [], "presentation": { "reveal": "always" }
    }
  ],
  "inputs": [
    {
      "id": "confirmFileReset", "type": "promptString",
      "description": "Überschreibt .run/baseline/SessionCatalog.pas. Zuerst Änderungen sichern. RESET eingeben."
    },
    {
      "id": "confirmCommit", "type": "promptString",
      "description": "Erster lokaler Commit im isolierten Workspace: alle Dateien vorher prüfen. COMMIT eingeben."
    }
  ]
}
